#!/bin/sh
# tvManager - post-removal (busybox sh)
# Called with "remove"/"purge" when the plugin is removed and with "upgrade"
# (and others) during an upgrade: only clean up on a real removal, otherwise
# the selected cam would be lost at every update.

case "$1" in
    remove|purge) ;;
    *) exit 0 ;;
esac

for PLUGIN_DIR in /usr/lib/enigma2/python/Plugins/Extensions/tvManager \
                  /usr/lib64/enigma2/python/Plugins/Extensions/tvManager; do
    # files not owned by the package (.pyc, __pycache__, local settings)
    [ -d "$PLUGIN_DIR" ] && rm -rf "$PLUGIN_DIR"
done

# Files written by tvManager only
rm -f /etc/clist.list /etc/startcam.sh /etc/tvManager/last_update_check

# Cam config backups are kept on "remove", deleted on "purge"
if [ "$1" = "purge" ]; then
    rm -rf /etc/tvManager
else
    rmdir /etc/tvManager 2>/dev/null
    [ -d /etc/tvManager/backup ] && echo "tvManager: cam config backups kept in /etc/tvManager/backup"
fi

# Original image script moved away by the plugin autostart
if [ -f /etc/init.d/dccamdOrig ] && [ ! -e /etc/init.d/dccamd ]; then
    mv /etc/init.d/dccamdOrig /etc/init.d/dccamd
fi

echo "tvManager removed - restart the GUI"
exit 0
