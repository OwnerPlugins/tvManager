#!/bin/sh
# tvManager - pre-installation (busybox sh, no network, no opkg calls:
# the package manager is locked while this script runs)

PLUGIN_DIR=/usr/lib/enigma2/python/Plugins/Extensions/tvManager
[ -d /usr/lib64/enigma2 ] && PLUGIN_DIR=/usr/lib64/enigma2/python/Plugins/Extensions/tvManager

echo "tvManager: pre-installation"

# Compiled files of an older version would shadow the new .py files
if [ -d "$PLUGIN_DIR" ]; then
    find "$PLUGIN_DIR" -name "*.pyc" -exec rm -f {} \; 2>/dev/null
    find "$PLUGIN_DIR" -name "*.pyo" -exec rm -f {} \; 2>/dev/null
    find "$PLUGIN_DIR" -type d -name "__pycache__" -exec rm -rf {} \; 2>/dev/null
fi

exit 0
