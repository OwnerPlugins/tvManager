#!/bin/sh
# tvManager - post-installation (busybox sh, no network, no opkg calls)

PLUGIN_DIR=/usr/lib/enigma2/python/Plugins/Extensions/tvManager
[ -d /usr/lib64/enigma2 ] && PLUGIN_DIR=/usr/lib64/enigma2/python/Plugins/Extensions/tvManager

for dir in /usr/keys /usr/camscript /etc/tvManager/backup; do
    [ -d "$dir" ] || mkdir -p "$dir"
done
chmod 755 /usr/keys /usr/camscript 2>/dev/null

# Active cam (empty = none). Existing file is kept: the selected cam survives the upgrade
[ -f /etc/clist.list ] || : > /etc/clist.list
chmod 644 /etc/clist.list 2>/dev/null

chmod 755 "$PLUGIN_DIR"/data/*.sh 2>/dev/null

if [ ! -f "$PLUGIN_DIR/plugin.py" ]; then
    echo "tvManager: plugin files missing in $PLUGIN_DIR"
    exit 1
fi

echo "======================================================="
echo " tvManager installed - restart the GUI to load it"
echo " Menu -> Plugins -> Softcam Manager"
echo "======================================================="
exit 0
